# WatsonX AI Credentials (Required)
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# WatsonX AI Configuration (Optional — defaults shown)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=mistralai/mistral-small-3-2-24b-instruct-2506
WATSONX_MAX_RETRIES=3

# Data Source (Required — local CSV path)
DATA_PATH=with_label.csv

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Server port
PORT=8080
